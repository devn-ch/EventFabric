  "exports": "./src/index.ts",
  "fmt": {
    "include": [
      "src/"
    ],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "always"
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "test": {
    "include": [
      "src/"
    ]
  },
  "imports": {
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fmt": "jsr:@std/fmt@^1.0.9",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "zod": "npm:zod@^4.3.6"
  }
}